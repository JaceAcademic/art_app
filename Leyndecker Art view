
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <football-hero>Image Resize on Click</football-hero>
    <style>
       
           .resizable-image {
            width: 300px; /* Initial width */
            height: auto;
            cursor: pointer;
            /* Smooth transition effect when the size changes */
            transition: transform 0.3s ease, width 0.3s ease; 
        }

    
        .resizable-image.enlarged {
             transform: scale(1.5); /* Scales the image up by 50% */